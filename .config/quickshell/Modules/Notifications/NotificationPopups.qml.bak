import Quickshell
import Quickshell.Wayland
import QtQuick
import QtQuick.Layouts
import "../../theme"

PanelWindow {
    id: popupWindow
    
    // 1. Position & Layer
    anchors.top: true
    anchors.right: true
    width: 300
    
    margins.top: 0   
    // Dynamic height based on the sliding content
    height: backgroundSurface.height

    // Ensure it shows over fullscreen games
    WlrLayershell.layer: WlrLayer.Overlay
    exclusionMode: ExclusionMode.None
    color: "transparent"

    // 2. Logic & State
    // Revealed when we have notifications
    property bool revealed: false

    Connections {
        target: notificationModel
        function onCountChanged() {
            if (notificationModel.count > 0) popupWindow.revealed = true
        }
    }
    
    // Visible if  OR if the content is still sliding up (animation running)
    visible: revealed || backgroundSurface.y > -(backgroundSurface.height - 1)

    // 3. Click-through Mask
    // Only accept clicks where the background actually IS
    mask: backgroundSurface


    function removeNotification(notificationObject) {
         // Find the index of the notification
         var index = -1;
         for (var i = 0; i < notificationModel.count; i++) {
             if (notificationModel.get(i).notif === notificationObject) {
                 index = i;
                 break;
             }
         }
         if (index === -1) return;
 
         // If this is the LAST notification, slide up the window first!
         if (notificationModel.count === 1) {
             popupWindow.revealed = false; // Trigger slide up
             
             // Wait for animation (300ms) before destroying the data
             // (We create a quick timer here)
             var t = Qt.createQmlObject('import QtQuick; Timer {interval: 350; running: true; repeat: false;}', popupWindow);
             t.triggered.connect(function() {
                 if (notificationModel.count > 0) notificationModel.remove(index);
                 t.destroy();
             });
         } else {
             // If others remain, just remove this one immediately
             notificationModel.remove(index);
         }
     }

    // 4. The Viewport (Clipping Mask)
    Item {
        anchors.fill: parent
        clip: true // This cuts off the notification when it slides "up"

        // 5. The Sliding Surface (Background + Content)
        Rectangle {
            id: backgroundSurface
            width: parent.width
            
            // Height is driven by the content layout
            height: layout.implicitHeight



            

            // ANIMATION LOGIC:
			Behavior on height {
		        NumberAnimation { 
		            duration: 300
		            easing.type: Easing.OutQuart 
		        }
		    }
		
	
            
            // Revealed: y = 0
            // Hidden: y = -height (slides up completely out of view)
            y: popupWindow.revealed ? 0 : -height
            
            Behavior on y {
                NumberAnimation { 
                    duration: 300
                    easing.type: Easing.OutQuart
                }
            }

            color: Theme.background
            radius: 8
            
            // Visual filler to square off top corners (matches your bar)
            Rectangle {
                id: topfill
                anchors.top: parent.top
                anchors.left: parent.left
                anchors.right: parent.right
                height: 15
                color: Theme.background 
                radius: 0
            }

            ColumnLayout {
                id: layout
                anchors.left: parent.left
                anchors.right: parent.right
                anchors.top: parent.top // Anchor to top of background
                spacing: 0

                // (Removed the Transform logic here; the parent Rectangle moves now)

                Repeater {
                    model: notificationModel
                    delegate: Item { 
                        Layout.fillWidth: true
                        implicitHeight: 60


                       
                        Connections {
                            target: model.notif
                            function onClosed() {
                                popupWindow.removeNotification(model.notif);
                            }
                        }

                        MouseArea {
                            anchors.fill: parent
                            onClicked: {
                                model.notif.dismiss();
                                popupWindow.removeNotification(model.notif);
                            }
                        }
                       
                        // Divider Line
                        Rectangle {
                            anchors.bottom: parent.bottom
                            width: parent.width * 0.9
                            anchors.horizontalCenter: parent.horizontalCenter
                            height: 1
                            color: Theme.empty
                            visible: index < notificationModel.count - 1
                        }

                        RowLayout {
                            anchors.fill: parent
                            anchors.margins: 10
                            spacing: 10
                            
                            Image {
                                source: model.notif.image || "dialog-information"
                                Layout.preferredWidth: 40
                                Layout.preferredHeight: 40
                            }

                            ColumnLayout {
                                spacing: 2
                                Text { 
                                    text: model.notif.summary 
                                    color: Theme.accent
                                    font.bold: true 
                                    Layout.fillWidth: true
                                    elide: Text.ElideRight
                                }
                                Text { 
                                    text: model.notif.body 
                                    color: Theme.text
                                    elide: Text.ElideRight 
                                    Layout.fillWidth: true
                                }
                            }
                        }

                        Timer {
                            interval: (model.notif.timeout > 0) ? model.notif.timeout : 5000
                            running: true
                            onTriggered: {
                                var n = model.notif;
                                if (n) {
                                    n.dismiss();
                                    popupWindow.removeNotification(n);
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
