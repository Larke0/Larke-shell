/* ROUNDED THEME FOR ROFI */
/* Author: Newman Sanchez (https://github.com/newmanls) */
/* Modified by: Larke */
* {
    bg0:    {{colors.surface.default.hex}};
    bg1:    #3B4252;
    bg2:    {{colors.tertiary.default.hex}};
    bg3:    {{colors.primary.default.hex | set_saturation: 100}};
    fg0:    #D8DEE9;
    fg1:    #ECEFF4;
    fg2:    #D8DEE9;
    fg3:    #4C566A;
}

@import "template/rounded-template.rasi"

element selected {
    text-color: @bg1;
}
