#############
### INPUT ###
#############

# https://wiki.hypr.land/Configuring/Variables/#input

# Mouse, Keyboard, and Gaps
input {
    accel_profile = flat
    sensitivity = -0.83
    kb_layout = br
    kb_variant = abnt2

    scroll_factor = 1
}

binds {
    scroll_event_delay = 100
}

general {
    gaps_in = 1
    gaps_out = 5
    resize_on_border = false
}

cursor {
    no_hardware_cursors = false
}



# --- My Special Workspace Window Rules ---
windowrulev2 = workspace special:Whatsapp, class:^(ZapZap)$
workspace = special:Whatsapp, on-created-empty: zapzap
windowrulev2 = workspace special:Whatsapp, class:^(org.telegram.desktop)$

windowrulev2 = workspace special:discord, class:^(vesktop)
windowrulev2 = workspace special:discord, initialClass:^(vesktop)$
windowrulev2 = workspace special:discord, initialTitle:^(Discord)$
#workspace = special:discord, on-created-empty: vesktop

windowrulev2 = workspace special:spotify, class:^((s|S)potify)$


#Forces PSIM to tile
windowrulev2 = tile, class:^(psim.exe)$
windowrulev2 = tile, class:^(simview.exe)$


# Force Minecraft to always tile
windowrulev2 = tile, class:^(Minecraft.*)$, title:^(Minecraft*)$

#Makes wayland never sleep FFXIV
windowrulev2 = renderunfocused, class:^(ffxiv_dx11.exe)$


animations {
    #enabled = yes

    # Syntax: animation = NAME, ON/OFF, SPEED, CURVE, STYLE

    # OPTION 1: Slide in from the top (Classic "Console" feel)
    #animation = specialWorkspace, 1, 6, default, slidevert

    # OPTION 2: Fade in (Subtle)
    # animation = specialWorkspace, 1, 6, default, fade

    # OPTION 3: Scale/Zoom (Pop up effect)
    # animation = specialWorkspace, 1, 6, default, scale
}
#Default blur
decoration {
    blur {
        enabled = yes
        size = 5
        passes = 2
        ignore_opacity = true

        noise = 0.08
        contrast = 1.5
        brightness = 0.8

        xray = false
        new_optimizations = true
    }
}




###################
### MY PROGRAMS ###
###################

# See https://wiki.hypr.land/Configuring/Keywords/

# Set programs that you use
$terminal = kitty
$fileManager = nautilus --new-window
$menu = hyprlauncher
$browser = zen-browser




